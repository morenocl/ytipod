YTIPOD_DATABASE=/path/to/ytipod/ytipod.db
YTIPOD_DOWNLOAD_DIR=/path/to/ytipod/downloads
YTIPOD_LOG_DIR=/path/to/ytipod/logs
YTIPOD_TEMP_DIR=/path/to/ytipod/tmp
YTIPOD_IPOD_MOUNT=/media/ipod
YTIPOD_IPOD_YOUTUBE_DIR=/media/ipod/Youtube
YTIPOD_IPOD_PODCAST_DIR=/media/ipod/Podcast
YTIPOD_IPOD_VIDEO_WIDTH=320
YTIPOD_IPOD_VIDEO_HEIGHT=240
YTIPOD_IPOD_VIDEO_FPS=25
YTIPOD_IPOD_VIDEO_BITRATE=450k
YTIPOD_IPOD_AUDIO_BITRATE=128k
YTIPOD_TELEGRAM_TOKEN=<TELEGRAM_BOT_TOKEN>
YTIPOD_TELEGRAM_ALLOWED_CHAT_ID=<TELEGRAM_CHAT_ID>
YTIPOD_DAILY_RUN_TIME=03:00

YTIPOD_WEB_HOST=127.0.0.1
YTIPOD_WEB_PORT=8080
YTIPOD_WEB_USERNAME=admin
YTIPOD_WEB_PASSWORD=<CHANGE_ME>
